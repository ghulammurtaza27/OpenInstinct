# Optional local overrides. When omitted in development, the app creates stable
# installation secrets under LOCAL_DATA_DIR.
BETTER_AUTH_SECRET=
# OpenInstinct uses its own port so it does not collide with another local UI.
OPENINSTINCT_PORT=3100
BETTER_AUTH_URL=http://127.0.0.1:3100
# `pnpm dev` overrides both with the local Docker Compose database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/open_instinct
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@127.0.0.1:54329/open_instinct
# Optional base64-encoded 32-byte override. Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=
# Optional legacy cloud browser key. Leave empty for local chat only.
KERNEL_API_KEY=
# Both the root agent and browser worker use this local OpenAI-compatible model.
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL_ID=/models/Qwen3.6-35B-A3B-UD-IQ4_NL.gguf
LOCAL_MODEL_CONTEXT_TOKENS=65536
# Leave empty when the local endpoint does not require authentication.
LOCAL_MODEL_API_KEY=
LOCAL_DATA_DIR=./data/local-openinstinct
# Development benchmarks only (pnpm bench:browser).
BROWSER_BENCH_LABEL=self-hosted
BROWSER_BENCH_REPETITIONS=1
